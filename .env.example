# Copy to .env and adjust. All values are optional.

# Ollama server and default model used for AI explanations
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Maximum accepted upload / pasted source size in KB
MAX_UPLOAD_KB=512

# Seconds before a Bandit scan is aborted
BANDIT_TIMEOUT=30
